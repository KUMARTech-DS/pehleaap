
# ==========================================
# PEHLE AAP - GCP DEPLOYMENT CONFIGURATION
# ==========================================

# GCP Project
GCP_PROJECT_ID=festivehackphleapp
GCP_REGION=asia-south1
GCP_ZONE=asia-south1-a

# GKE
GKE_CLUSTER_NAME=pehle-aap
GKE_NAMESPACE=pehle-aap

# Application
APP_NAME=pehle-aap
APP_DOMAIN=YOUR_DOMAIN_HERE

# Database
DB_NAME=pehle_aap
DB_USER=pehle_aap
DB_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD

# Container Registry
GAR_LOCATION=asia-south1
GAR_REPOSITORY=pehle-aap

# Application Environment
APP_ENV=production

# Kubernetes
K8S_NAMESPACE=pehle-aap

# Logging
LOG_LEVEL=INFO

# ==========================================
# ADDITIONAL API KEYS
# Populate only if required by the script.
# ==========================================

FLAGS​MITH_API_KEY=YOUR_FLAGSMITH_API_KEY
FLAGS​MITH_ENVIRONMENT_KEY=YOUR_FLAGSMITH_ENVIRONMENT_KEY
