
# ==========================================
# PEHLE AAP - GCP DEPLOYMENT CONFIGURATION
# ==========================================

# GCP Project
PROJECT_ID=festivehackphleapp
GCP_PROJECT_ID=festivehackphleapp
REGION=asia-south1
ZONE=asia-south1-a

# GKE
CLUSTER_NAME=pehle-aap
NAMESPACE=pehle-aap

# Application
APP_NAME=pehle-aap
APP_ENV=production
APP_DOMAIN=YOUR_ACTUAL_DOMAIN

# Database
DB_NAME=pehle_aap
DB_USER=pehle_aap
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD

# Artifact Registry
GAR_LOCATION=asia-south1
GAR_REPOSITORY=pehle-aap

# Flagsmith
FLAGSMITH_SERVER_KEY=YOUR_ROTATED_FLAGSMITH_SERVER_KEY
FLAGSMITH_CLIENT_KEY=YOUR_FLAGSMITH_CLIENT_ENVIRONMENT_KEY

# Sarvam AI
SARVAM_API_KEY=YOUR_ROTATED_SARVAM_API_KEY

# Google Geocoding
GEOCODING_API_KEY=YOUR_GOOGLE_GEOCODING_API_KEY

# NudgeBee - Optional
NUDGEBEE_AGENT_KEY=

# Logging
LOG_LEVEL=INFO

# Application feature toggles
NUDGEBEE_ENABLED=false
